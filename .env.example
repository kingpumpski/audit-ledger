# Copy this file to .env.local and supply your Supabase project settings.
# Use a separate development Supabase project. Never put service-role or secret keys here.
VITE_SUPABASE_PROJECT_ID=your-development-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-development-publishable-key
VITE_SUPABASE_URL=https://your-development-project-id.supabase.co
